POSTGRES_DB=weatherdb
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
DATABASE_URL=postgresql+psycopg://weather:weather@postgres:5432/weatherdb

RABBITMQ_DEFAULT_USER=weather
RABBITMQ_DEFAULT_PASS=weather
RABBITMQ_URL=amqp://weather:weather@rabbitmq:5672/%2F
RABBITMQ_QUEUE=weather.events
RABBITMQ_DLQ=weather.events.dlq

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

WEATHER_UPDATE_MINUTES=360
MAX_RETRIES=5
ACTIVITY=running

API_URL=http://api:8000
